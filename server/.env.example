# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=8080
APP_ENV=development

# CricAPI Configuration (if using external cricket API)
CRICAPI_KEY=your_cricapi_key_here

# Cricbuzz RapidAPI Configuration
CRICBUZZ_LIVE_URL=https://cricbuzz-cricket.p.rapidapi.com/matches/v1/live
CRICBUZZ_API_HOST=cricbuzz-cricket.p.rapidapi.com
CRICBUZZ_API_KEY=your_cricbuzz_api_key_here
SCORES_POLL_INTERVAL=10

# Primary Fallback API (ipl-okn0.onrender.com) - used when RapidAPI fails
IPL_PRIMARY_FALLBACK_URL=https://ipl-okn0.onrender.com/ipl-2026-live-score

# Secondary Fallback API (api.cricapi.com) - used when primary fallback fails
CRICBUZZ_FALLBACK_KEY=your_cricapi_fallback_key
CRICBUZZ_FALLBACK_SERIES_ID=87c62aac-bc3c-4738-ab93-19da0690488f

# CORS Configuration
CORS_ORIGIN=http://localhost:5173